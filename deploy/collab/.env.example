# One-time auth key: Tailscale admin console > Settings > Keys > Generate auth key (not reusable, not ephemeral).
TS_AUTHKEY=tskey-auth-REPLACE_ME
# Where the collab hub's unix socket lives (must match `mmi --profile collab config --socket .../hub.sock`).
# MMI_SOCKET_DIR=/home/you/.local/share/memyselfandi/collab/sock
